# Godot 4 - archivos generados automáticamente
.godot/

# Archivos de importación (se regeneran solos al abrir el proyecto)
.import/
*.import

# Exportaciones del juego (binarios compilados)
export/
exports/
*.exe
*.x86_64
*.x86
*.arm64
*.arm
*.apk
*.aab
*.ipa
*.dmg
*.zip
*.pck
*.app

# Presets de exportación (contienen rutas locales, no compartir)
export_presets.cfg

# Archivos temporales del editor de Godot
*.tmp
*.bak

# Mono / C# (si en algún momento usan C# en Godot)
.mono/
data_*/
mono_crash.*.json

# Archivos de sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Editores de código
.vscode/
.idea/
*.suo
*.user
